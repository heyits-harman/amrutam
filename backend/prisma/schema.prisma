generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  RESERVED  // Temporary lock during checkout
  BOOKED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  phoneNumber         String?              @unique
  passwordHash        String
  role                UserRole             @default(PATIENT)
  isMfaEnabled        Boolean              @default(false)
  mfaSecret           String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relationships
  profile             Profile?
  doctorProfile       DoctorProfile?
  patientBookings     Consultation[]       @relation("PatientConsultations")
  auditLogs           AuditLog[]

  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model DoctorProfile {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @unique @db.Uuid
  specialization String
  licenseNumber  String             @unique
  experienceYears Int
  consultationFee Decimal            @db.Decimal(10, 2)
  bio            String?
  isVerified     Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relationships
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots          AvailabilitySlot[]
  consultations  Consultation[]     @relation("DoctorConsultations")

  @@index([specialization])
  @@map("doctor_profiles")
}

model AvailabilitySlot {
  id             String           @id @default(uuid()) @db.Uuid
  doctorId       String           @db.Uuid
  startTime      DateTime
  endTime        DateTime
  status         SlotStatus       @default(AVAILABLE)
  version        Int              @default(0) // Optimistic concurrency control
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relationships
  doctor         DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation   Consultation?

  // Indexes for high-frequency slot availability queries
  @@index([doctorId, startTime, endTime, status])
  @@index([startTime, status])
  @@map("availability_slots")
}

model Consultation {
  id             String           @id @default(uuid()) @db.Uuid
  patientId      String           @db.Uuid
  doctorId       String           @db.Uuid
  slotId         String           @unique @db.Uuid
  status         BookingStatus    @default(PENDING)
  notes          String?
  version        Int              @default(0) // Optimistic concurrency control
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relationships
  patient        User             @relation("PatientConsultations", fields: [patientId], references: [id])
  doctor         DoctorProfile    @relation("DoctorConsultations", fields: [doctorId], references: [id])
  slot           AvailabilitySlot @relation(fields: [slotId], references: [id])
  prescription   Prescription?
  payment        Payment?

  @@index([patientId, status])
  @@index([doctorId, status])
  @@map("consultations")
}

model Prescription {
  id             String       @id @default(uuid()) @db.Uuid
  consultationId String       @unique @db.Uuid
  medicines      Json         // Stored as array of objects [{ name, dosage, frequency, duration }]
  instructions   String?
  issuedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  consultationId String        @unique @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique // Prevents duplicate charges at API level
  gatewayTxnId   String?       @unique
  rawMetadata    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  consultation   Consultation  @relation(fields: [consultationId], references: [id])

  @@index([idempotencyKey])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   // e.g., "BOOK_SLOT", "CANCEL_CONSULTATION", "CREATE_PRESCRIPTION"
  resource   String   // e.g., "Consultation:uuid"
  ipAddress  String?
  userAgent  String?
  metadata   Json?    // Contextual snapshot of changes
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}